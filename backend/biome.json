{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": { "noForEach": "off" },
      "style": {
        "useNodejsImportProtocol": "error",
        "noNonNullAssertion": "off"
      }
    }
  },
  "files": { "includes": ["src/**/*.ts", "prisma/seed.ts"] }
}
