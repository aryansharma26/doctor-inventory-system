# Production requires Node.js 22.13+ (Node.js 24 recommended) and persistent disk.
# Use a separate directory for production; development creates sample records.
# HOSPITAL_DATA_DIR=/var/lib/medistock
# If HTTPS terminates at a reverse proxy, set the browser-facing origin:
# HOSPITAL_PUBLIC_ORIGIN=https://hospital.example.com

# Configure strong, separate passwords before starting in production mode.
HOSPITAL_ADMIN_PASSWORD=
HOSPITAL_ADMIN_LOGIN=admin
HOSPITAL_RECEPTION_PASSWORD=
HOSPITAL_RECEPTION_LOGIN=reception
HOSPITAL_DOCTOR_PASSWORD=
HOSPITAL_DOCTOR_LOGIN=doctor
HOSPITAL_PHARMACY_PASSWORD=
HOSPITAL_PHARMACY_LOGIN=pharmacy
# Optional additional doctors, each bound to their own queue:
HOSPITAL_MEERA_LOGIN=doctor.meera
HOSPITAL_MEERA_PASSWORD=
HOSPITAL_ROHAN_LOGIN=doctor.rohan
HOSPITAL_ROHAN_PASSWORD=

# Development uses sample records. Every department still requires its own login.
# For an explicitly public SAMPLE-DATA demonstration only:
# HOSPITAL_DEMO_MODE=1
